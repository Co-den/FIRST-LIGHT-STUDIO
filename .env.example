NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
DATABASE_URL=
AUTH_SECRET=              # generate with: npx auth secret
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET= # signed preset: allowed formats jpg/png/webp, max file size set in Cloudinary
ADMIN_EMAIL=              # used only by npm run db:seed
ADMIN_PASSWORD=
PAYSTACK_SECRET_KEY=      # sk_test_... or sk_live_... Never expose to the client
RESEND_API_KEY=           # optional until you want password-reset emails (any provider can replace src/lib/email.js)
EMAIL_FROM=               # e.g. "FIRST LIGHT STUDIO <no-reply@yourdomain>"
FREE_DRAFT_MAX_SERIES=3    # CONFIG VALUE for creators with no plan; set to your policy
FREE_DRAFT_STORAGE_MB=100  # CONFIG VALUE for creators with no plan; set to your policy
PLATFORM_STORAGE_WARN_MB=  # optional: admin warning when total image storage nears this
NEXT_PUBLIC_HERO_IMAGE=   # optional, e.g. /images/hero/hero.jpg once the file exists in /public
